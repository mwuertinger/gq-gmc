# Systemd unit for gq-gmc on hal. Install to /etc/systemd/system/.
#
# Runs as a transient, unprivileged user (DynamicUser=) without any
# capabilities. The only privilege it needs is the serial port of the Geiger
# counter: it gets the dialout group, and of the real devices the device cgroup
# allows only USB serial ports (ttyUSB*), plus the standard pseudo devices
# (/dev/null, zero, random, tty, ...). It only talks to InfluxDB on loopback.
# Check with:
#   systemd-analyze security gq-gmc.service

[Unit]
Description=GQ GMC Geiger counter to InfluxDB
Documentation=https://github.com/mwuertinger/gq-gmc
After=docker.service

[Service]
Type=exec
# by-path names the physical USB port. by-id is not unique for CH340 adapters
# (no serial number), so a second one would get the same by-id name.
ExecStart=/usr/local/bin/gq-gmc -dev /dev/serial/by-path/platform-3f980000.usb-usb-0:1.3:1.0-port0 -influxAddr http://[::1]:8086 -logRawCommunication
Restart=always
RestartSec=10s

# Identity: random UID/GID allocated at start, plus the dialout group that owns
# /dev/ttyUSB*. No PrivateUsers=: it has not been tested with the dialout group
# unmapped inside the user namespace, and it adds little here, since the
# service has no capabilities anyway.
DynamicUser=yes
SupplementaryGroups=dialout
UMask=0077

# No privileges at all.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
RestrictSUIDSGID=yes

# File system: everything read-only, no home directories, private /tmp, and
# nothing but the binary itself may be executed. The binary must be statically
# linked (CGO_ENABLED=0) for that. PrivateDevices= would hide the serial port,
# so the device cgroup restricts device access instead: of the real devices only
# USB serial ports (all ttyUSB*, so a second USB serial adapter as well).
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=char-ttyUSB rw
ProtectProc=invisible
ProcSubset=pid
NoExecPaths=/
ExecPaths=/usr/local/bin/gq-gmc
MemoryDenyWriteExecute=yes
# /dev/shm stays the host's (shared, writable) even with PrivateDevices=; not needed.
InaccessiblePaths=/dev/shm

# Kernel attack surface.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateIPC=yes
RemoveIPC=yes
KeyringMode=private
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# Network: InfluxDB on loopback only.
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

TasksMax=32

[Install]
WantedBy=multi-user.target
